pipeline {
    agent any

    stages {

        stage('Checkout') {
            steps {
                git branch: 'main',
                    url: 'https://github.com/tappashaikmohammadsamiullah/Three-Tier-Applications.git'
            }
        }

        stage('Build') {
            steps {
                bat 'cd Docker-Compose-Projects && docker compose build'
            }
        }

        stage('Test') {
            steps {
                bat 'cd Docker-Compose-Projects && docker compose config'
            }
        }

        stage('Deploy') {
            steps {
                bat 'cd Docker-Compose-Projects && docker compose up -d'
            }
        }

        stage('Health Check') {
            steps {
                bat 'cd Docker-Compose-Projects && docker compose ps'
            }
        }

        stage('Cleanup') {
            steps {
                bat 'cd Docker-Compose-Projects && docker image prune -f'
            }
        }
    }
}